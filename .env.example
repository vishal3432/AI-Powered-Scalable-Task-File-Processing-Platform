# ══════════════════════════════════════════════════
# AI-Powered Task & File Processing Platform
# Environment Configuration - Render Edition
# ══════════════════════════════════════════════════
# 
# FOR LOCAL DEVELOPMENT:
#   1. Run: make generate-secrets
#   2. Run: cp .env.example .env
#   3. Edit .env with your values
#
# FOR RENDER DEPLOYMENT:
#   1. Set these environment variables in Render dashboard
#   2. Database credentials are auto-injected by Render
#   3. Use generate-secrets to create DJANGO_SECRET_KEY and JWT_SECRET_KEY

# ─────────────────────────────────────────
# Environment Type
# ─────────────────────────────────────────
ENV=development
DEBUG=False

# ─────────────────────────────────────────
# PostgreSQL Database Configuration
# ─────────────────────────────────────────
# FOR LOCAL DEV: Uncomment these and set manually
# POSTGRES_DB=ai_platform
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# FOR RENDER: Use DATABASE_URL (provided by Render)
# Render automatically sets this - uncomment only if testing locally
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# ─────────────────────────────────────────
# Django Settings
# ─────────────────────────────────────────
# Generate with: openssl rand -hex 50
DJANGO_SECRET_KEY=CHANGE_ME_run_make_generate-secrets

DJANGO_DEBUG=False

# FOR PRODUCTION: Add your actual domain(s)
# Examples: api.example.com,api.example.com:8000,*.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com

# ─────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────
# Must be same across Django and FastAPI services!
# Generate with: openssl rand -hex 50
JWT_SECRET_KEY=CHANGE_ME_run_make_generate-secrets

JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ─────────────────────────────────────────
# AI Provider (OpenAI)
# ─────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Models available: gpt-3.5-turbo, gpt-4, gpt-4-turbo
AI_MODEL=gpt-3.5-turbo

# ─────────────────────────────────────────
# File Processing
# ─────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ─────────────────────────────────────────
# CORS Configuration (comma-separated)
# ─────────────────────────────────────────
# FOR LOCAL DEV:
# CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:3000

# FOR PRODUCTION: Add your frontend URL(s)
# Examples: https://example.com,https://app.example.com,https://*.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:3000,https://*.onrender.com

# ─────────────────────────────────────────
# Service URLs
# ─────────────────────────────────────────
# FOR LOCAL DEV:
# FASTAPI_BASE_URL=http://localhost:8001
# DJANGO_BASE_URL=http://localhost:8000

# FOR RENDER: These are auto-configured in render.yaml
# FASTAPI_BASE_URL=https://fastapi-processor-service.onrender.com
# DJANGO_BASE_URL=https://django-auth-service.onrender.com
